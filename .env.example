# JobPilot AI Environment Configuration

# Hugging Face Inference API (OpenAI-compatible endpoint)
HF_TOKEN=hf_your_token_here
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct
HF_BASE_URL=https://api-inference.huggingface.co/v1
HF_TIMEOUT_SECONDS=30
HF_MAX_RETRIES=3

# Application Settings
APP_ENV=development
DEMO_MODE=true
DATABASE_PATH=data/jobpilot.db
LOG_LEVEL=INFO

# Scheduler Settings
SCHEDULER_ENABLED=false
DAILY_RUN_HOUR=9
DAILY_RUN_MINUTE=0
TIMEZONE=Asia/Kolkata

# Matcher Thresholds
MIN_MATCH_SCORE_TO_DRAFT=70.0
AUTO_REJECT_BELOW_SCORE=30.0

# Daily Email Digest Configuration
DIGEST_RECIPIENT_EMAIL=your_email@example.com
ENABLE_EMAIL_DIGEST=true
# Optional SMTP configuration (if blank, digests are safely stored locally in data/email_digests/)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
SMTP_USE_TLS=true

# Multi-Platform API / Feed Configurations
# Naukri enterprise recruiter credentials (optional)
NAUKRI_API_KEY=
# LinkedIn developer app credentials with approved r_jobs scope (optional)
LINKEDIN_CLIENT_ID=
LINKEDIN_ACCESS_TOKEN=
# Indeed authorized employer XML feed URL (optional)
INDEED_FEED_URL=
# Career ATS public board identifiers (comma-separated)
GREENHOUSE_BOARDS=canonical,cloudflare,gitlab
LEVER_COMPANIES=figma,postman
